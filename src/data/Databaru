const BASE_URL = "https://jsonplaceholder.typicode.com/users";

const data = (email) => {
  return fetch(BASE_URL)
    .then((response) => response.json())
    .then((users) => {
      const user = users.find((user) => user.email === email);
      if (user) {
        return user;
      } else {
        throw new Error("User not found");
      }
    });
};
const name = (email) => {
  return data(email)
    .then((user) => user.name)
    .catch((error) => {
      console.error(error);
      return null;
    });
};
